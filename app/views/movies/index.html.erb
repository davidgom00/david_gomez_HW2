<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>
<h1>Movies</h1>

<thead>Sort by: 
  <tr>
    <th><%= link_to "Movie Title", movies_path(:sort => :title) %></th>
    <th><%= link_to "Release Date", movies_path(:sort => :release_date) %></th>
    <th><%= link_to "Rating", movies_path(:sort => :rating) %></th>
  </tr>
</thead>


<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Release date</th>
      <th>Rating</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.release_date %></td>
        <td><%= movie.rating %></td>
        <td><%= link_to 'Show', movie %></td>
      </tr>
    <% end %>
  </tbody>
</table>


<%= link_to "New movie", new_movie_path %>
